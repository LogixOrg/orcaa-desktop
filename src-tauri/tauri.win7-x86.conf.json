{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "webview2-runtime/x86/MicrosoftEdgeWebView2RuntimeInstaller.exe": "webview2/MicrosoftEdgeWebView2RuntimeInstaller.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installerHooks": "./windows/win7-webview2.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LogixOrg/orcaa-desktop/releases/latest/download/latest-win7.json"
      ]
    }
  }
}
